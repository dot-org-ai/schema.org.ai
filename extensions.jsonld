{
  "@context": {
    "schema": "https://schema.org/",
    "schemaai": "https://schema.org.ai/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  },
  "@graph": [
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Agent",
      "rdfs:label": "Agent",
      "rdfs:comment": "An autonomous AI agent that can perform actions, use tools, and make decisions to accomplish goals.",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Tool",
      "rdfs:label": "Tool",
      "rdfs:comment": "A tool that can be used by an Agent to perform actions. Tools expose capabilities through defined interfaces.",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Capability",
      "rdfs:label": "Capability",
      "rdfs:comment": "A capability or skill that an Agent possesses, defining what actions it can perform.",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Model",
      "rdfs:label": "Model",
      "rdfs:comment": "An AI/ML model that powers an Agent or provides inference capabilities.",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Prompt",
      "rdfs:label": "Prompt",
      "rdfs:comment": "A prompt or prompt template used to instruct an AI model or Agent.",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Generation",
      "rdfs:label": "Generation",
      "rdfs:comment": "An AI generation instance, representing output produced by a Model or Agent.",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Workflow",
      "rdfs:label": "Workflow",
      "rdfs:comment": "An autonomous workflow definition that specifies a sequence of actions to be performed by Agents.",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:API",
      "rdfs:label": "API",
      "rdfs:comment": "An API endpoint (REST, RPC, GraphQL) that provides programmatic access to services.",
      "rdfs:subClassOf": {
        "@id": "schema:WebAPI"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Webhook",
      "rdfs:label": "Webhook",
      "rdfs:comment": "A webhook endpoint that receives event-driven notifications.",
      "rdfs:subClassOf": {
        "@id": "schema:WebAPI"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:MCP",
      "rdfs:label": "MCP",
      "rdfs:comment": "A Model Context Protocol server that exposes tools and resources to AI models.",
      "rdfs:subClassOf": {
        "@id": "schema:WebAPI"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:SDK",
      "rdfs:label": "SDK",
      "rdfs:comment": "A Software Development Kit package that provides programmatic access to a platform or service.",
      "rdfs:subClassOf": {
        "@id": "schema:SoftwareApplication"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:CLI",
      "rdfs:label": "CLI",
      "rdfs:comment": "A Command-Line Interface tool for interacting with services from the terminal.",
      "rdfs:subClassOf": {
        "@id": "schema:SoftwareApplication"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:LandingPage",
      "rdfs:label": "LandingPage",
      "rdfs:comment": "A conversion-optimized marketing landing page with hero, features, testimonials, and CTA sections.",
      "rdfs:subClassOf": {
        "@id": "schema:WebPage"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Company",
      "rdfs:label": "Company",
      "rdfs:comment": "A concrete firm: an organization that operates in an Industry, instantiates a CompanyType archetype, employs workers, and buys and sells. ADMITTED EXTENSION per Nathan's F5 ruling (org.ai#11, 2026-07-18): 'Company = extension (subClassOf schema:Organization, per the R3 exemplar)' — schema.org has no Company; the clean term is ours to mint. Business is NOT ADMITTED (same ruling): Company carries the referent.",
      "rdfs:subClassOf": {
        "@id": "schema:Organization"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:DigitalProperty",
      "rdfs:label": "DigitalProperty",
      "rdfs:comment": "A digital property — a website, app, API, deployed agent, or any addressable entity with a stable digital presence. The unifying type for things that have URLs and are accessible in the digital realm.",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Industry",
      "rdfs:label": "Industry",
      "rdfs:comment": "An industry classification (e.g. NAICS-coded sector of economic activity). The taxonomic category that groups businesses by what they produce. Distinct from schema:Organization (which is an instance of a Business operating within an Industry).",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:CompanyType",
      "rdfs:label": "CompanyType",
      "rdfs:comment": "A company archetype derived from Industry × business model × regulatory regime. More specific than Industry (which is a NAICS-coded sector) and more general than a specific Business. Examples: Accounting Firm, Plumbing Contractor, Boutique Hotel.",
      "rdfs:subClassOf": {
        "@id": "schema:Organization"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:JobType",
      "rdfs:label": "JobType",
      "rdfs:comment": "A job-type archetype — a specific role within a CompanyType. Derived from Occupation × CompanyType. Examples: Staff Bookkeeper at an Accounting Firm, Service Plumber at a Plumbing Contractor. More specific than schema:Occupation.",
      "rdfs:subClassOf": {
        "@id": "schema:Occupation"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Department",
      "rdfs:label": "Department",
      "rdfs:comment": "A functional department within a CompanyType (e.g. Tax, Audit, Engineering). Groups related JobTypes and Tasks. Subtype of Organization because departments are sub-organizations.",
      "rdfs:subClassOf": {
        "@id": "schema:Organization"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Task",
      "rdfs:label": "Task",
      "rdfs:comment": "A granular unit of work — typically an O*NET task statement or comparable imperative work action. The typed unit of work itself, addressable as canonical reference. NATIVE per the ADR 0002 R3 bucket ruling: deliberately no subClassOf schema:Action — schema.org's Action means performed events; claiming its lineage for work-to-be-done would be a semantic error."
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Process",
      "rdfs:label": "Process",
      "rdfs:comment": "A cross-functional business process — typically an APQC-coded multi-step operation (e.g. Manage Accounts Payable, Onboard New Customer). Distinct from schema:HowTo (which is consumer-facing instructions) — a Process is the typed enterprise operation.",
      "rdfs:subClassOf": {
        "@id": "schema:HowTo"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Problem",
      "rdfs:label": "Problem",
      "rdfs:comment": "A canonical Problem — pain exposed by a sufficiently-pinned Ideal Customer Profile. Addressable so multiple candidate Solutions can be enumerated. Distinct from schema:Issue (which is a content issue) — a Problem is a market problem.",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Thesis",
      "rdfs:label": "Thesis",
      "rdfs:comment": "The strategic bet a startup is founded on — the cascade's thesis noun (Service-as-Software, Agent, Headless SaaS are canonical theses). NATIVE per Nathan's ruling (org.ai#11, 2026-07-18): 'Problem, Thesis → native now (recurrence-proven, live-emitted)'. SHADOWS schema.org/Thesis (a dissertation document — different referent sharing the name) per org.ai ADR 0004 Q3 mechanics: the bare term binds here; the dissertation sense stays reachable by full IRI. Distinct from InvestmentThesis (fund-side).",
      "schemaai:shadows": {
        "@id": "schema:Thesis"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:InvestmentThesis",
      "rdfs:label": "InvestmentThesis",
      "rdfs:comment": "An investment or strategic thesis — a structured argument for a particular approach to building (e.g. Service-as-Software, Agent, Headless SaaS). Stackable: one Thesis composes a Solution from primitives at lower-layer Theses. Named `InvestmentThesis` (not `Thesis`) to avoid collision with schema:Thesis (academic dissertation).",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:digital",
      "rdfs:label": "digital",
      "rdfs:comment": "Digital maturity score from 0.0 (fully analog/manual) to 1.0 (fully digital/autonomous). Indicates the degree to which an entity operates digitally.",
      "schema:domainIncludes": {
        "@id": "schema:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Number"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:capability",
      "rdfs:label": "capability",
      "rdfs:comment": "A capability or skill that this Agent possesses.",
      "schema:domainIncludes": {
        "@id": "schemaai:Agent"
      },
      "schema:rangeIncludes": {
        "@id": "schemaai:Capability"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:tool",
      "rdfs:label": "tool",
      "rdfs:comment": "A tool available to this Agent for performing actions.",
      "schema:domainIncludes": {
        "@id": "schemaai:Agent"
      },
      "schema:rangeIncludes": {
        "@id": "schemaai:Tool"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:model",
      "rdfs:label": "model",
      "rdfs:comment": "The AI model(s) that power this Agent or Generation.",
      "schema:domainIncludes": [
        {
          "@id": "schemaai:Agent"
        },
        {
          "@id": "schemaai:Generation"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "schemaai:Model"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:workflow",
      "rdfs:label": "workflow",
      "rdfs:comment": "A workflow that this Agent can execute.",
      "schema:domainIncludes": {
        "@id": "schemaai:Agent"
      },
      "schema:rangeIncludes": {
        "@id": "schemaai:Workflow"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:goal",
      "rdfs:label": "goal",
      "rdfs:comment": "The goal or objective that this Agent is trying to achieve.",
      "schema:domainIncludes": {
        "@id": "schemaai:Agent"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        },
        {
          "@id": "schema:Thing"
        }
      ]
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:prompt",
      "rdfs:label": "prompt",
      "rdfs:comment": "The prompt used to generate this output.",
      "schema:domainIncludes": {
        "@id": "schemaai:Generation"
      },
      "schema:rangeIncludes": {
        "@id": "schemaai:Prompt"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:temperature",
      "rdfs:label": "temperature",
      "rdfs:comment": "The temperature parameter used for AI generation (0.0-2.0).",
      "schema:domainIncludes": {
        "@id": "schemaai:Generation"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Number"
      }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:tokens",
      "rdfs:label": "tokens",
      "rdfs:comment": "The number of tokens used or generated.",
      "schema:domainIncludes": {
        "@id": "schemaai:Generation"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Integer"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Role",
      "rdfs:label": "Role",
      "rdfs:comment": "A job role definition: a named position/function with required skills, responsibilities, permissions, tool grants, delegation/approval/escalation edges, and a preferred worker type (agent or human). NATIVE and SHADOWS per the ADR 0002 R3 bucket ruling: schema.org/Role is a reified edge-qualifier — a different concept sharing the name. The context term Role maps here; schema.org's Role stays reachable by full IRI.",
      "schemaai:shadows": {
        "@id": "schema:Role"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Event",
      "rdfs:label": "Event",
      "rdfs:comment": "A business occurrence: the immutable, past-tense record that something happened, carrying What/Who/When/Where/Why/How dimensions. NATIVE, SHADOWING schema.org/Event, and SEAM-MAPPED to GS1 EPCIS 2.0 per org.ai ADR 0004 (first application): Q1 fails (merging occurrence records into concert listings is meaning-destroying), Q2 lineage veto (an EPCIS-shaped receiving event is not truthfully a schema:Event, so NO subClassOf edge), Q3 shadow (bare term binds here; schema.org/Event stays one full IRI away), and EPCIS integrates per R17 as a protocol seam.",
      "schemaai:shadows": {
        "@id": "schema:Event"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Team",
      "rdfs:label": "Team",
      "rdfs:comment": "A team: a named group of workers (agents and humans) with members, an optional lead, goals, and communication channels. ADMITTED EXTENSION per the ADR 0002 R3 bucket ruling: subClassOf schema:Organization — schema.org has no generic Team; crawlers walking the subclass edge still understand the parent type.",
      "rdfs:subClassOf": {
        "@id": "schema:Organization"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Product",
      "rdfs:label": "Product",
      "rdfs:comment": "A product the platform's businesses make, sell, or use — spanning instance-grain products and the UNSPSC-seeded product-category taxonomy. ADMITTED EXTENSION per Nathan's F5 ruling (org.ai#11, 2026-07-18): 'Product, Service, Offer = extension (subClassOf schema:Product / schema:Service / schema:Offer)' — org.ai ADR 0004 Q2; category grain tolerated (grain diverges, nothing false).",
      "rdfs:subClassOf": {
        "@id": "schema:Product"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Offer",
      "rdfs:label": "Offer",
      "rdfs:comment": "An offer a platform business makes: the packaged promise — what is delivered, to whom (ICP coordinates), how, and on what pricing structure. ADMITTED EXTENSION per Nathan's F5 ruling (org.ai#11, 2026-07-18): subClassOf schema:Offer — org.ai ADR 0004 Q2.",
      "rdfs:subClassOf": {
        "@id": "schema:Offer"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Service",
      "rdfs:label": "Service",
      "rdfs:comment": "A service a platform business provides — including services-as-software (services delivered by agents with software economics). ADMITTED EXTENSION per Nathan's F5 ruling (org.ai#11, 2026-07-18): subClassOf schema:Service — org.ai ADR 0004 Q2.",
      "rdfs:subClassOf": {
        "@id": "schema:Service"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Startup",
      "rdfs:label": "Startup",
      "rdfs:comment": "A startup company threading the lifecycle stages idea → validating → building → scaling → established, with pitch, industry, and its ICPs. The unit the venue mints (G4) and tenants operate (G5).",
      "rdfs:subClassOf": {
        "@id": "schema:Organization"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:ICP",
      "rdfs:label": "ICP",
      "rdfs:comment": "An Ideal Customer Profile in the as/at/are/using/to framework: who they are (as), where they work (at), their current situation (are), what they use today (using), and the outcome they want (to).",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:JTBD",
      "rdfs:label": "JTBD",
      "rdfs:comment": "A Job To Be Done in the When/I-want/So-I-can pattern: situation, motivation, outcome — optionally scored on functional, emotional, and social dimensions with priority and frequency.",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Hypothesis",
      "rdfs:label": "Hypothesis",
      "rdfs:comment": "A testable assumption with evidence collection: a statement, the metric it moves, a target value, testing status, and collected evidence — the validation unit behind an Idea.",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Worker",
      "rdfs:label": "Worker",
      "rdfs:comment": "The base work-executor type over the agent/human duality: Worker { type: 'agent' | 'human' } with status, capabilities, and current task. Agents and humans are Workers; the interface is uniform (notify/ask/approve/decide/do).",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Idea",
      "rdfs:label": "Idea",
      "rdfs:comment": "A business concept with a name, an elevator pitch, and a lifecycle status, validated through Hypotheses on its way to becoming a Startup.",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      }
    }
  ]
}
