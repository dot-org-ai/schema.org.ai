{
  "@context": {
    "schema": "https://schema.org/",
    "schemaai": "https://schema.org.ai/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  },
  "@graph": [
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Agent",
      "rdfs:label": "Agent",
      "rdfs:comment": "An autonomous AI agent that can perform actions, use tools, and make decisions to accomplish goals.",
      "rdfs:subClassOf": { "@id": "schema:Thing" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Tool",
      "rdfs:label": "Tool",
      "rdfs:comment": "A tool that can be used by an Agent to perform actions. Tools expose capabilities through defined interfaces.",
      "rdfs:subClassOf": { "@id": "schema:Thing" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Capability",
      "rdfs:label": "Capability",
      "rdfs:comment": "A capability or skill that an Agent possesses, defining what actions it can perform.",
      "rdfs:subClassOf": { "@id": "schema:Intangible" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Model",
      "rdfs:label": "Model",
      "rdfs:comment": "An AI/ML model that powers an Agent or provides inference capabilities.",
      "rdfs:subClassOf": { "@id": "schema:Thing" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Prompt",
      "rdfs:label": "Prompt",
      "rdfs:comment": "A prompt or prompt template used to instruct an AI model or Agent.",
      "rdfs:subClassOf": { "@id": "schema:CreativeWork" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Generation",
      "rdfs:label": "Generation",
      "rdfs:comment": "An AI generation instance, representing output produced by a Model or Agent.",
      "rdfs:subClassOf": { "@id": "schema:CreativeWork" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Workflow",
      "rdfs:label": "Workflow",
      "rdfs:comment": "An autonomous workflow definition that specifies a sequence of actions to be performed by Agents.",
      "rdfs:subClassOf": { "@id": "schema:CreativeWork" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:API",
      "rdfs:label": "API",
      "rdfs:comment": "An API endpoint (REST, RPC, GraphQL) that provides programmatic access to services.",
      "rdfs:subClassOf": { "@id": "schema:WebAPI" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Webhook",
      "rdfs:label": "Webhook",
      "rdfs:comment": "A webhook endpoint that receives event-driven notifications.",
      "rdfs:subClassOf": { "@id": "schema:WebAPI" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:MCP",
      "rdfs:label": "MCP",
      "rdfs:comment": "A Model Context Protocol server that exposes tools and resources to AI models.",
      "rdfs:subClassOf": { "@id": "schema:WebAPI" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:SDK",
      "rdfs:label": "SDK",
      "rdfs:comment": "A Software Development Kit package that provides programmatic access to a platform or service.",
      "rdfs:subClassOf": { "@id": "schema:SoftwareApplication" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:CLI",
      "rdfs:label": "CLI",
      "rdfs:comment": "A Command-Line Interface tool for interacting with services from the terminal.",
      "rdfs:subClassOf": { "@id": "schema:SoftwareApplication" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:LandingPage",
      "rdfs:label": "LandingPage",
      "rdfs:comment": "A conversion-optimized marketing landing page with hero, features, testimonials, and CTA sections.",
      "rdfs:subClassOf": { "@id": "schema:WebPage" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Business",
      "rdfs:label": "Business",
      "rdfs:comment": "A business entity that can be represented as Business-as-Code, with autonomous operations.",
      "rdfs:subClassOf": { "@id": "schema:Organization" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:DigitalProperty",
      "rdfs:label": "DigitalProperty",
      "rdfs:comment": "A digital property — a website, app, API, deployed agent, or any addressable entity with a stable digital presence. The unifying type for things that have URLs and are accessible in the digital realm.",
      "rdfs:subClassOf": { "@id": "schema:Thing" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Industry",
      "rdfs:label": "Industry",
      "rdfs:comment": "An industry classification (e.g. NAICS-coded sector of economic activity). The taxonomic category that groups businesses by what they produce. Distinct from schema:Organization (which is an instance of a Business operating within an Industry).",
      "rdfs:subClassOf": { "@id": "schema:Intangible" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:CompanyType",
      "rdfs:label": "CompanyType",
      "rdfs:comment": "A company archetype derived from Industry × business model × regulatory regime. More specific than Industry (which is a NAICS-coded sector) and more general than a specific Business. Examples: Accounting Firm, Plumbing Contractor, Boutique Hotel.",
      "rdfs:subClassOf": { "@id": "schema:Organization" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:JobType",
      "rdfs:label": "JobType",
      "rdfs:comment": "A job-type archetype — a specific role within a CompanyType. Derived from Occupation × CompanyType. Examples: Staff Bookkeeper at an Accounting Firm, Service Plumber at a Plumbing Contractor. More specific than schema:Occupation.",
      "rdfs:subClassOf": { "@id": "schema:Occupation" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Department",
      "rdfs:label": "Department",
      "rdfs:comment": "A functional department within a CompanyType (e.g. Tax, Audit, Engineering). Groups related JobTypes and Tasks. Subtype of Organization because departments are sub-organizations.",
      "rdfs:subClassOf": { "@id": "schema:Organization" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Task",
      "rdfs:label": "Task",
      "rdfs:comment": "A granular unit of work — typically an O*NET task statement or comparable imperative work action. Distinct from schema:Action (the act of performing) — a Task is the typed unit of work itself, addressable as canonical reference.",
      "rdfs:subClassOf": { "@id": "schema:Action" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Process",
      "rdfs:label": "Process",
      "rdfs:comment": "A cross-functional business process — typically an APQC-coded multi-step operation (e.g. Manage Accounts Payable, Onboard New Customer). Distinct from schema:HowTo (which is consumer-facing instructions) — a Process is the typed enterprise operation.",
      "rdfs:subClassOf": { "@id": "schema:HowTo" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Problem",
      "rdfs:label": "Problem",
      "rdfs:comment": "A canonical Problem — pain exposed by a sufficiently-pinned Ideal Customer Profile. Addressable so multiple candidate Solutions can be enumerated. Distinct from schema:Issue (which is a content issue) — a Problem is a market problem.",
      "rdfs:subClassOf": { "@id": "schema:Thing" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Opportunity",
      "rdfs:label": "Opportunity",
      "rdfs:comment": "A market opportunity — a Problem coupled with a Thesis approach and target ICP, scoped to a buildable solution space. The 'where to build' artifact in startup discovery.",
      "rdfs:subClassOf": { "@id": "schema:Thing" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Market",
      "rdfs:label": "Market",
      "rdfs:comment": "A market — the competitive field of incumbents, substitutes, and status-quo solutions addressing a Problem. Distinct from schema:Place (geographic) — a Market is a competitive landscape.",
      "rdfs:subClassOf": { "@id": "schema:Intangible" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:InvestmentThesis",
      "rdfs:label": "InvestmentThesis",
      "rdfs:comment": "An investment or strategic thesis — a structured argument for a particular approach to building (e.g. Service-as-Software, Agent, Headless SaaS). Stackable: one Thesis composes a Solution from primitives at lower-layer Theses. Named `InvestmentThesis` (not `Thesis`) to avoid collision with schema:Thesis (academic dissertation).",
      "rdfs:subClassOf": { "@id": "schema:CreativeWork" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:AutonomyLevel",
      "rdfs:label": "AutonomyLevel",
      "rdfs:comment": "The level axis of an AutonomyClaim — how much of the business's consequential-verb portfolio the system owns. Six levels L0–L5, derived from SAE J3016's driving-automation levels by a recorded delta table; L5 carries claimable: false. Levels are always cited by fully-scoped $id (https://schema.org.ai/AutonomyLevel/L4), never as a bare glyph.",
      "rdfs:subClassOf": { "@id": "schema:Enumeration" },
      "rdfs:seeAlso": { "@id": "https://standards.org.ai/SAE/J3016" }
    },
    {
      "@type": "schemaai:AutonomyLevel",
      "@id": "schemaai:AutonomyLevel/L0",
      "rdfs:label": "L0",
      "rdfs:comment": "No autonomy. Humans perform and own every consequential verb; the system at most records and reports."
    },
    {
      "@type": "schemaai:AutonomyLevel",
      "@id": "schemaai:AutonomyLevel/L1",
      "rdfs:label": "L1",
      "rdfs:comment": "Assistance. The system assists inside a human-owned verb; the human performs the verb and owns the outcome."
    },
    {
      "@type": "schemaai:AutonomyLevel",
      "@id": "schemaai:AutonomyLevel/L2",
      "rdfs:label": "L2",
      "rdfs:comment": "Per-verb approval. The system executes, but a human approval edge gates each consequential verb; the human owns each approved outcome."
    },
    {
      "@type": "schemaai:AutonomyLevel",
      "@id": "schemaai:AutonomyLevel/L3",
      "rdfs:label": "L3",
      "rdfs:comment": "Conditional autonomy. The system owns verbs within the DeclaredScope, with a fallback-ready human who must take over on escalation."
    },
    {
      "@type": "schemaai:AutonomyLevel",
      "@id": "schemaai:AutonomyLevel/L4",
      "rdfs:label": "L4",
      "rdfs:comment": "High autonomy. The system owns outcomes within the DeclaredScope with a machine-reachable, duty-preserving MinimalRiskCondition on scope-exit. Human seats sit outside the org boundary, procured through the membrane, and count as tier-lowering controllability credits, never operators."
    },
    {
      "@type": "schemaai:AutonomyLevel",
      "@id": "schemaai:AutonomyLevel/L5",
      "rdfs:label": "L5",
      "rdfs:comment": "Full autonomy — unbounded scope. Not claimable (claimable: false): an estate amendment contra the J3016 seed. An unbounded DeclaredScope is unfalsifiable; the honest claim is always L4-with-scope.",
      "schemaai:claimable": false
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:AssuranceTier",
      "rdfs:label": "AssuranceTier",
      "rdfs:comment": "The tier axis of an AutonomyClaim — the assurance a business's unmitigated worst-case consequence demands. Five tiers T0–T4, assigned upstream (severity × exposure × reversibility × credential predicate), never self-selected. The (level, tier) factoring is deliberately isomorphic to the industry's own (J3016, ASIL/DAL/SIL) split.",
      "rdfs:subClassOf": { "@id": "schema:Enumeration" },
      "rdfs:seeAlso": [
        { "@id": "https://standards.org.ai/ISO/26262" },
        { "@id": "https://standards.org.ai/RTCA/DO-178C" },
        { "@id": "https://standards.org.ai/IEC/61508" }
      ]
    },
    {
      "@type": "schemaai:AssuranceTier",
      "@id": "schemaai:AssuranceTier/T0",
      "rdfs:label": "T0",
      "rdfs:comment": "Advisory. No assurance claimed; outputs are revocable and relied on at the consumer's own risk."
    },
    {
      "@type": "schemaai:AssuranceTier",
      "@id": "schemaai:AssuranceTier/T1",
      "rdfs:label": "T1",
      "rdfs:comment": "Demonstrated. Self-attested evidence of correct operation; transactions reversible in regime."
    },
    {
      "@type": "schemaai:AssuranceTier",
      "@id": "schemaai:AssuranceTier/T2",
      "rdfs:label": "T2",
      "rdfs:comment": "Commerce floor. Selling under a signed Offer, or holding a credential/regulated predicate, or custodial third-party system-of-record data (A5) ⇒ ≥T2. Demands the T2 commerce pack: signed offer, idempotent settlement, refund path, reasons log, degraded-but-lawful MRC, evidence ledger."
    },
    {
      "@type": "schemaai:AssuranceTier",
      "@id": "schemaai:AssuranceTier/T3",
      "rdfs:label": "T3",
      "rdfs:comment": "Covenant floor. Discretionary capital deployment binds T3 at the envelope-mint covenant (R12-1), and any verb — or covenant-obligation lapse — that irreversibly extinguishes or encumbers third-party rights without independent adjudication is ≥T3 regardless of amount (A1)."
    },
    {
      "@type": "schemaai:AssuranceTier",
      "@id": "schemaai:AssuranceTier/T4",
      "rdfs:label": "T4",
      "rdfs:comment": "Custodial floor. Custody of third-party funds ⇒ T4. Unchanged by the A5 data floors."
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:DeclaredScope",
      "rdfs:label": "DeclaredScope",
      "rdfs:comment": "The scope axis of an AutonomyClaim — the declared operational domain (per-verb) within which the system owns outcomes. Derived from SAE J3016's Operational Design Domain (ODD). Exclusions are typed as DoctrineWalls: the wall list and the scope exclusions are one object read twice (R12-2).",
      "rdfs:subClassOf": { "@id": "schema:Intangible" },
      "rdfs:seeAlso": { "@id": "https://standards.org.ai/SAE/J3016#ODD" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:SeamClass",
      "rdfs:label": "SeamClass",
      "rdfs:comment": "The classification of a seam where a business verb crosses the membrane. Four classes: Attestation, TransactionInRegime, CovenantVerb, NeverMintWall. Seam class determines how the verb prices on the AssuranceTier axis.",
      "rdfs:subClassOf": { "@id": "schema:Enumeration" }
    },
    {
      "@type": "schemaai:SeamClass",
      "@id": "schemaai:SeamClass/Attestation",
      "rdfs:label": "Attestation",
      "rdfs:comment": "The business states something others rely on (data, grades, benchmarks). Assurance rides on the statement's evidence; where others allocate on the attestation, the tier rises with the reliance."
    },
    {
      "@type": "schemaai:SeamClass",
      "@id": "schemaai:SeamClass/TransactionInRegime",
      "rdfs:label": "TransactionInRegime",
      "rdfs:comment": "Bounded consideration exchanged against a signed Offer with an external financial adjudicator. Prices at T2 (R12-1 settlement carve-out): the T3 floor binds deployment of capital, not settlement of consideration."
    },
    {
      "@type": "schemaai:SeamClass",
      "@id": "schemaai:SeamClass/CovenantVerb",
      "rdfs:label": "CovenantVerb",
      "rdfs:comment": "A human signs a ceiling once; the machine mints narrowing children within it. The T3 moment lives at the envelope-mint covenant, not at each settlement (R12-1)."
    },
    {
      "@type": "schemaai:SeamClass",
      "@id": "schemaai:SeamClass/NeverMintWall",
      "rdfs:label": "NeverMintWall",
      "rdfs:comment": "A verb the estate never mints — a DoctrineWall in seam position (e.g. no-custody-ever). Removal is a re-tiering event."
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:DoctrineWall",
      "rdfs:label": "DoctrineWall",
      "rdfs:comment": "A constitutive constraint — structurally verifiable, reopenable only by governance — that DEFINES a business's hazard class (R12-2). Distinct from mitigating controls, which are excluded from tier assignment and become the tier's demanded evidence. Anti-gaming test: remove the constraint — is the residue the same business? Wall removal is a re-tiering event.",
      "rdfs:subClassOf": { "@id": "schema:Intangible" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:MinimalRiskCondition",
      "rdfs:label": "MinimalRiskCondition",
      "rdfs:comment": "A machine-reachable, duty-preserving business halt entered on scope-exit. Derived from SAE J3016's minimal risk condition. Every MRC must declare a lawfulDegradedState of Frozen (de-armed, state held, duties preserved) or Flat (exposure closed to zero).",
      "rdfs:subClassOf": { "@id": "schema:Intangible" },
      "rdfs:seeAlso": { "@id": "https://standards.org.ai/SAE/J3016" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:AutonomyClaim",
      "rdfs:label": "AutonomyClaim",
      "rdfs:comment": "The complete, honest autonomy claim: {level, scope, assuranceTier, mrc}. The bare word 'autonomous' is never claimable alone; AutonomyLevel/L5 is not claimable; the tier is assigned upstream, never self-selected. The claim attaches to declared scopes, not to a brand.",
      "rdfs:subClassOf": { "@id": "schema:Intangible" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:EvidenceRegister",
      "rdfs:label": "EvidenceRegister",
      "rdfs:comment": "The tier-governed register of the two-register logging law: append-only objects under retention hold, deletion structurally unavailable (a DoctrineWall), retained at least as long as the longest open dispute window, counterparty-checkable. The evidence is the object, never the table: any catalog above it is a view with zero evidentiary status. Retention derives from tier, never storage cost.",
      "rdfs:subClassOf": { "@id": "schema:Intangible" },
      "rdfs:seeAlso": { "@id": "https://standards.org.ai/GS1/EPCIS" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:ObservabilityRegister",
      "rdfs:label": "ObservabilityRegister",
      "rdfs:comment": "The cost-governed register of the two-register logging law: expirable, sampled, mutable (the hot window). Every metered event writes to both registers; expiry is a property of the observability register only.",
      "rdfs:subClassOf": { "@id": "schema:Intangible" }
    },
    {
      "@type": "rdfs:Class",
      "@id": "schemaai:Law",
      "rdfs:label": "Law",
      "rdfs:comment": "A thin normative venue commitment that cites open-register definitions by fully-scoped $id and never redefines them. Define once in the open register; legislate thin in the venue. Deliberately NOT subclassed from schema:Legislation — that class carries the civil-statute register; a canon Law is a venue commitment, wrong-register for Legislation.",
      "rdfs:subClassOf": { "@id": "schema:CreativeWork" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:digital",
      "rdfs:label": "digital",
      "rdfs:comment": "Digital maturity score from 0.0 (fully analog/manual) to 1.0 (fully digital/autonomous). Indicates the degree to which an entity operates digitally.",
      "schema:domainIncludes": { "@id": "schema:Thing" },
      "schema:rangeIncludes": { "@id": "schema:Number" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:capability",
      "rdfs:label": "capability",
      "rdfs:comment": "A capability or skill that this Agent possesses.",
      "schema:domainIncludes": { "@id": "schemaai:Agent" },
      "schema:rangeIncludes": { "@id": "schemaai:Capability" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:tool",
      "rdfs:label": "tool",
      "rdfs:comment": "A tool available to this Agent for performing actions.",
      "schema:domainIncludes": { "@id": "schemaai:Agent" },
      "schema:rangeIncludes": { "@id": "schemaai:Tool" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:model",
      "rdfs:label": "model",
      "rdfs:comment": "The AI model(s) that power this Agent or Generation.",
      "schema:domainIncludes": [
        { "@id": "schemaai:Agent" },
        { "@id": "schemaai:Generation" }
      ],
      "schema:rangeIncludes": { "@id": "schemaai:Model" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:workflow",
      "rdfs:label": "workflow",
      "rdfs:comment": "A workflow that this Agent can execute.",
      "schema:domainIncludes": { "@id": "schemaai:Agent" },
      "schema:rangeIncludes": { "@id": "schemaai:Workflow" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:goal",
      "rdfs:label": "goal",
      "rdfs:comment": "The goal or objective that this Agent is trying to achieve.",
      "schema:domainIncludes": { "@id": "schemaai:Agent" },
      "schema:rangeIncludes": [
        { "@id": "schema:Text" },
        { "@id": "schema:Thing" }
      ]
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:prompt",
      "rdfs:label": "prompt",
      "rdfs:comment": "The prompt used to generate this output.",
      "schema:domainIncludes": { "@id": "schemaai:Generation" },
      "schema:rangeIncludes": { "@id": "schemaai:Prompt" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:temperature",
      "rdfs:label": "temperature",
      "rdfs:comment": "The temperature parameter used for AI generation (0.0-2.0).",
      "schema:domainIncludes": { "@id": "schemaai:Generation" },
      "schema:rangeIncludes": { "@id": "schema:Number" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:tokens",
      "rdfs:label": "tokens",
      "rdfs:comment": "The number of tokens used or generated.",
      "schema:domainIncludes": { "@id": "schemaai:Generation" },
      "schema:rangeIncludes": { "@id": "schema:Integer" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:claimable",
      "rdfs:label": "claimable",
      "rdfs:comment": "Whether this AutonomyLevel may appear in an AutonomyClaim. false on AutonomyLevel/L5 — an estate amendment contra the J3016 seed: an unbounded scope is unfalsifiable, so the honest claim is always L4-with-scope.",
      "schema:domainIncludes": { "@id": "schemaai:AutonomyLevel" },
      "schema:rangeIncludes": { "@id": "schema:Boolean" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:level",
      "rdfs:label": "level",
      "rdfs:comment": "The AutonomyLevel of this AutonomyClaim. Always a fully-scoped $id (https://schema.org.ai/AutonomyLevel/L4), never a bare glyph.",
      "schema:domainIncludes": { "@id": "schemaai:AutonomyClaim" },
      "schema:rangeIncludes": { "@id": "schemaai:AutonomyLevel" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:scope",
      "rdfs:label": "scope",
      "rdfs:comment": "The DeclaredScope of this AutonomyClaim — the per-verb operational domain within which the level is claimed.",
      "schema:domainIncludes": { "@id": "schemaai:AutonomyClaim" },
      "schema:rangeIncludes": { "@id": "schemaai:DeclaredScope" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:assuranceTier",
      "rdfs:label": "assuranceTier",
      "rdfs:comment": "The AssuranceTier of this AutonomyClaim. Assigned upstream from unmitigated worst-case consequence, never self-selected. Machine-legible in offer metadata.",
      "schema:domainIncludes": { "@id": "schemaai:AutonomyClaim" },
      "schema:rangeIncludes": { "@id": "schemaai:AssuranceTier" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:mrc",
      "rdfs:label": "mrc",
      "rdfs:comment": "The MinimalRiskCondition of this AutonomyClaim — the machine-reachable, duty-preserving halt entered on scope-exit.",
      "schema:domainIncludes": { "@id": "schemaai:AutonomyClaim" },
      "schema:rangeIncludes": { "@id": "schemaai:MinimalRiskCondition" }
    },
    {
      "@type": "rdf:Property",
      "@id": "schemaai:lawfulDegradedState",
      "rdfs:label": "lawfulDegradedState",
      "rdfs:comment": "Required on every MinimalRiskCondition. The lawful degraded state the MRC enters: 'Frozen' (de-armed, state held, obligations preserved) or 'Flat' (exposure closed to zero). A kill that de-arms without flattening is Frozen and must be declared as such.",
      "schema:domainIncludes": { "@id": "schemaai:MinimalRiskCondition" },
      "schema:rangeIncludes": { "@id": "schema:Text" }
    }
  ]
}
