{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "schemaai": "https://schema.org.ai/"
  },
  "@graph": [
    {
      "@id": "https://schema.org.ai/temperature",
      "@type": "rdf:Property",
      "rdfs:label": "temperature",
      "rdfs:comment": "The temperature parameter used for AI generation (0.0-2.0).",
      "schema:domainIncludes": [
        {
          "@id": "https://schema.org.ai/Generation"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "https://schema.org/Number"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://schema.org.ai"
      }
    }
  ]
}
